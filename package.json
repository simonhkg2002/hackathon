{
  "name": "hong-kong-3d-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "data:refresh": "python3 scripts/update-buildings.py && npm run data:geometry-cache",
    "data:geometry-cache": "node scripts/cache-repair-geometries.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "proj4": "^2.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "image-size": "^2.0.3"
  }
}
