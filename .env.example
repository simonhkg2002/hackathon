# Defaults work without an API token. Copy to .env.local to override.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
VITE_MAP_LONGITUDE=114.16
VITE_MAP_LATITUDE=22.35
VITE_MAP_ZOOM=10.5
VITE_MAP_PITCH=0
VITE_MAP_BEARING=0

# OpenMapTiles-compatible building schema; height and base are in meters.
VITE_BUILDING_SOURCE=openmaptiles
VITE_BUILDING_SOURCE_LAYER=building
VITE_BUILDING_HEIGHT_PROPERTY=render_height
VITE_BUILDING_BASE_PROPERTY=render_min_height

# All VITE_* values are public browser configuration, never private secrets.
# For another provider, use its browser-safe, domain-restricted public token
# in VITE_MAP_STYLE_URL as documented by that provider.

# Server-only file for public demo repair tickets (not bundled into the browser).
DEMO_TICKETS_FILE=.local/demo-tickets.json
